diff --git a/source/blender/depsgraph/intern/builder/deg_builder.cc b/source/blender/depsgraph/intern/builder/deg_builder.cc
index c46b9144..25ba66aa 100644
--- a/source/blender/depsgraph/intern/builder/deg_builder.cc
+++ b/source/blender/depsgraph/intern/builder/deg_builder.cc
@@ -66,6 +66,10 @@ DepsgraphBuilder::DepsgraphBuilder(Main *bmain, Depsgraph *graph, DepsgraphBuild
 
 bool DepsgraphBuilder::need_pull_base_into_graph(const Base *base)
 {
+  /* Narwhal 3D draws these objects itself, so Blender need not evaluate them. */
+  if (base->flag & BASE_APP_DRAWN) {
+    return false;
+  }
   /* Simple check: enabled bases are always part of dependency graph. */
   const int base_flag = (graph_->mode == DAG_EVAL_VIEWPORT) ? BASE_ENABLED_VIEWPORT :
                                                               BASE_ENABLED_RENDER;
