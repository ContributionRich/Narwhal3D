#include <windows.h>

1 ICON "__ICON_PATH__"

1 VERSIONINFO
 FILEVERSION __VERSION_COMMA__
 PRODUCTVERSION __VERSION_COMMA__
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Narwhal 3D Contributors\0"
      VALUE "FileDescription", "Narwhal 3D early prerelease launcher\0"
      VALUE "FileVersion", "__VERSION__ prerelease\0"
      VALUE "InternalName", "Narwhal3D\0"
      VALUE "LegalCopyright", "GPL-3.0-or-later\0"
      VALUE "OriginalFilename", "Narwhal3D.exe\0"
      VALUE "ProductName", "Narwhal 3D\0"
      VALUE "ProductVersion", "__VERSION__ prerelease\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END

1 24
BEGIN
  "<?xml version='1.0' encoding='UTF-8' standalone='yes'?>"
  "<assembly xmlns='urn:schemas-microsoft-com:asm.v1' manifestVersion='1.0'>"
  "<trustInfo xmlns='urn:schemas-microsoft-com:asm.v3'><security><requestedPrivileges>"
  "<requestedExecutionLevel level='asInvoker' uiAccess='false'/>"
  "</requestedPrivileges></security></trustInfo>"
  "<application xmlns='urn:schemas-microsoft-com:asm.v3'><windowsSettings>"
  "<dpiAware xmlns='http://schemas.microsoft.com/SMI/2005/WindowsSettings'>true/pm</dpiAware>"
  "<longPathAware xmlns='http://schemas.microsoft.com/SMI/2016/WindowsSettings'>true</longPathAware>"
  "</windowsSettings></application></assembly>"
END
